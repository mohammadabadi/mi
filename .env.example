# Local / VPS PostgreSQL (SSL off automatically for localhost)
DATABASE_URL="postgresql://mifin:CHANGE_ME@127.0.0.1:5432/mifin"

# Optional overrides
# DATABASE_SSL=require
# DATABASE_SSL=disable
# DATABASE_POOL_MAX=10

# Comma-separated admin emails
ADMIN_EMAILS="you@example.com"

# Kept for compatibility; session auth does not currently require it
AUTH_SECRET="replace-with-a-long-random-secret"

# Node server bind (production)
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
