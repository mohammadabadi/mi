{
  "version": 3,
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_fonts/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_fonts(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "/transactions",
      "dest": "/transactions"
    },
    {
      "src": "/reports",
      "dest": "/reports"
    },
    {
      "src": "/register",
      "dest": "/register"
    },
    {
      "src": "/login",
      "dest": "/login"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard"
    },
    {
      "src": "/categories",
      "dest": "/categories"
    },
    {
      "src": "/api/transfers",
      "dest": "/api/transfers"
    },
    {
      "src": "/api/transactions",
      "dest": "/api/transactions"
    },
    {
      "src": "/api/reports/monthly",
      "dest": "/api/reports/monthly"
    },
    {
      "src": "/api/reports/income",
      "dest": "/api/reports/income"
    },
    {
      "src": "/api/reports/expenses",
      "dest": "/api/reports/expenses"
    },
    {
      "src": "/api/dashboard",
      "dest": "/api/dashboard"
    },
    {
      "src": "/api/categories",
      "dest": "/api/categories"
    },
    {
      "src": "/api/auth/register",
      "dest": "/api/auth/register"
    },
    {
      "src": "/api/auth/me",
      "dest": "/api/auth/me"
    },
    {
      "src": "/api/auth/logout",
      "dest": "/api/auth/logout"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login"
    },
    {
      "src": "/api/accounts",
      "dest": "/api/accounts"
    },
    {
      "src": "/accounts",
      "dest": "/accounts"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/",
      "dest": "/index"
    },
    {
      "src": "/api/transactions/(?<id>[^/]+)",
      "dest": "/api/transactions/[id]"
    },
    {
      "src": "/api/categories/(?<id>[^/]+)",
      "dest": "/api/categories/[id]"
    },
    {
      "src": "/api/accounts/(?<id>[^/]+)",
      "dest": "/api/accounts/[id]"
    },
    {
      "src": "/api/_nuxt_icon/(?<collection>[^/]+)",
      "dest": "/api/_nuxt_icon/[collection]"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}